# Backend Environment Variables Template

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# LLM Provider
LLM_PROVIDER=groq
GROQ_API_KEY=

# Storage Mode (file or database)
USE_DATABASE=false

# File Storage Paths
TEACHERS_PATH=./data/teachers.json
STUDENTS_PATH=./data/students.json
MATERIALS_PATH=./data/materials.json
SESSION_LOG_PATH=./data/sessions.json

# ============== GoDaddy cPanel Settings ==============
# Uncomment and configure if using database storage

# GODADDY_DB_HOST=localhost
# GODADDY_DB_USER=lurnr_user
# GODADDY_DB_PASSWORD=your_password_here
# GODADDY_DB_NAME=lurnr_db
# GODADDY_UPLOAD_URL=https://your-domain.com/lurnr-data/materials/
# GODADDY_UPLOAD_PATH=/home/cpaneluser/public_html/lurnr-data/materials/
# GODADDY_DOMAIN=your-domain.com
